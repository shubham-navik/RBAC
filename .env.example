
APP_NAME=RBAC System
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://Db_user:Db_password@localhost:5434/db_name

# Local Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Security: replace these with securely generated secrets
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security policies
PASSWORD_MIN_LENGTH=6
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=INFO